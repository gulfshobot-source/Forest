{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forest://schema/production-warrant/v0.1",
  "title": "Forest Production Warrant",
  "type": "object",
  "required": ["id", "state_version", "objective", "position", "task", "selection_reason", "inputs", "outputs", "tests", "permissions", "recovery", "measurement"],
  "properties": {
    "id": {"type": "string"},
    "state_version": {"type": "string"},
    "objective": {"type": "string"},
    "position": {"type": "string"},
    "task": {"type": "string"},
    "selection_reason": {"type": "string"},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "procedures": {"type": "array", "items": {"type": "string"}},
    "tests": {"type": "array", "items": {"type": "string"}},
    "permissions": {"type": "array", "items": {"type": "string"}},
    "recovery": {
      "type": "object",
      "required": ["retry_allowed", "rollback_required_on_failure"],
      "properties": {
        "retry_allowed": {"type": "boolean"},
        "max_retries": {"type": "integer", "minimum": 0, "default": 1},
        "rollback_required_on_failure": {"type": "boolean"},
        "notes": {"type": "string"}
      },
      "additionalProperties": true
    },
    "measurement": {"type": "array", "items": {"type": "string"}},
    "next_candidates": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
